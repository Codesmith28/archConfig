# ==============================================================================
# archConfig Universal Repository .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Secrets, Credentials & Local Machine Overrides
# ------------------------------------------------------------------------------
.wakatime.cfg
*.wakatime.cfg
core/home/.wakatime.cfg
.wakatime.cfg.local
*.wakatime.cfg.local
core/home/.wakatime.cfg.local
*.local
*.local.*
*.key
*.secret
*.token
*.log
.env
.env.*
!.env.example

# ------------------------------------------------------------------------------
# 2. Terminal, Editor & IDE Ephemeral Artifacts
# ------------------------------------------------------------------------------
# Ghostty syntax tree cache
.ast/
**/.ast/

# Vim / Neovim swap files & scratch buffers
*.swp
*.swo
*~
Untitled
core/config/nvim/Untitled

# macOS / OS metadata
.DS_Store
Thumbs.db

# ------------------------------------------------------------------------------
# 3. Cache & Runtime Temp Files
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
.cache/
**/.cache/
*.zsh_plugins.zsh
.zsh_plugins.zsh
.antidote
