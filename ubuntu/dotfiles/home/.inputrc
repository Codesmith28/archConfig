# ==============================================================================
# ~/.inputrc - GNU Readline configuration for Bash
# ==============================================================================

# Include system-wide Readline defaults (Home/End, Delete, Ctrl+Arrows, etc.)
$include /etc/inputrc

# ------------------------------------------------------------------------------
# 1. Tab Completion Enhancements
# ------------------------------------------------------------------------------
# Show completions immediately on a single Tab instead of requiring double Tab
set show-all-if-ambiguous on

# Case-insensitive tab completion
set completion-ignore-case on

# Treat hyphens and underscores as equivalent during tab completion
set completion-map-case on

# Append '/' to completed symlinked directories
set mark-symlinked-directories on

# Colorize completion list based on LS_COLORS (like ls/eza)
set colored-stats on

# Highlight the matching prefix in completion lists
set colored-completion-prefix on

# ------------------------------------------------------------------------------
# 2. History Search with Arrow Keys
# ------------------------------------------------------------------------------
# Type the prefix of a command (e.g. "git ") and press Up/Down to search history
"\e[A": history-search-backward
"\e[B": history-search-forward
"\eOA": history-search-backward
"\eOB": history-search-forward
