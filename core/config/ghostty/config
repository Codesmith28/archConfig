theme = TokyoNight Storm

font-family = monospace
font-style = Regular
font-size = 10
bold-color = bright

# Window
window-width = 170
window-height = 60

window-theme = ghostty
window-padding-x = 5
window-padding-y = 5
gtk-titlebar-style = tabs

confirm-close-surface=false
resize-overlay = never

# copy to clipboard:
copy-on-select = clipboard
clipboard-read = allow

# Cursor styling
cursor-style = "underline"
cursor-style-blink = true
adjust-cursor-thickness = 1

# Cursor styling + SSH session terminfo
# (all shell integration options must be passed together)
shell-integration-features = no-cursor,ssh-env

# Slowdown mouse scrolling
mouse-scroll-multiplier = 0.95

# Tab and Split Working Directory Inheritance
window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true

# Tab Navigation
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab

# Desktop Notifications
desktop-notifications = true
notify-on-command-finish = unfocused
notify-on-command-finish-action = notify
notify-on-command-finish-after = 1s

# macOS Compatibility (Ignored gracefully on Linux)
macos-titlebar-style = tabs
macos-option-as-alt = true
keybind = cmd+c=copy_to_clipboard
keybind = cmd+v=paste_from_clipboard
keybind = cmd+s=text:\x13

