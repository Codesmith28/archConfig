[org/gnome/desktop/interface]
accent-color='blue'
clock-format='24h'
clock-show-seconds=false
clock-show-weekday=false
cursor-theme='Notwaita-Black'
document-font-name='Sans 11'
font-antialiasing='rgba'
font-hinting='slight'
font-name='Sans 11'
gtk-enable-primary-paste=true
icon-theme='Adwaita'
monospace-font-name='Monospace 10'
show-battery-percentage=true
toolkit-accessibility=false

[org/gnome/desktop/peripherals/keyboard]
delay=uint32 250
repeat=true
repeat-interval=uint32 25

[org/gnome/desktop/peripherals/touchpad]
disable-while-typing=true
natural-scroll=true
tap-to-click=true

[org/gnome/desktop/wm/keybindings]
close=['<Super>q', '<Alt>F4']
minimize=['<Super>m']
move-to-center=['<Super>c']
move-to-side-e=@as []
move-to-side-w=@as []
move-to-workspace-1=['<Super><Shift>1']
move-to-workspace-2=['<Super><Shift>2']
move-to-workspace-3=['<Super><Shift>3']
move-to-workspace-4=['<Super><Shift>4']
move-to-workspace-5=['<Super><Shift>5']
move-to-workspace-6=['<Super><Shift>6']
move-to-workspace-7=['<Super><Shift>7']
move-to-workspace-8=['<Super><Shift>8']
move-to-workspace-9=['<Super><Shift>9']
move-to-workspace-down=['<Super><Shift>Page_Down']
move-to-workspace-last=['<Super><Shift>End']
move-to-workspace-left=['<Super><Shift>Page_Up']
move-to-workspace-right=['<Super><Shift>Page_Down']
move-to-workspace-up=['<Super><Shift>Page_Up']
switch-to-workspace-1=['<Super>1']
switch-to-workspace-2=['<Super>2']
switch-to-workspace-3=['<Super>3']
switch-to-workspace-4=['<Super>4']
switch-to-workspace-5=['<Super>5']
switch-to-workspace-6=['<Super>6']
switch-to-workspace-7=['<Super>7']
switch-to-workspace-8=['<Super>8']
switch-to-workspace-9=['<Super>9']
switch-to-workspace-down=['<Super>Page_Down']
switch-to-workspace-last=['<Super>End']
switch-to-workspace-left=['<Super>Page_Up']
switch-to-workspace-right=['<Super>Page_Down']
switch-to-workspace-up=['<Super>Page_Up']

[org/gnome/desktop/wm/preferences]
button-layout='appmenu:minimize,maximize,close'

[org/gnome/mutter]
center-new-windows=true
dynamic-workspaces=true

[org/gnome/settings-daemon/plugins/media-keys]
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0/']
home=['<Super>e']
www=['<Super><Shift>b']

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0]
binding='<Super>Return'
command='default-terminal'
name='Default Terminal'

[org/gnome/shell/extensions/blur-my-shell]
pipelines={'pipeline_default': {'name': <'Default'>, 'effects': <[<{'type': <'dual_kawase_blur'>, 'id': <'effect_8eaeb510-3fec-45da-a2cf-89dcee5af201'>, 'params': <@a{sv} {}>}>]>}, 'pipeline_default_light': {'name': <'Default (Light mode)'>, 'effects': <[<{'type': <'dual_kawase_blur'>, 'id': <'effect_default_light_blur'>, 'params': <{'unscaled_radius': <30>, 'brightness': <1>}>}>, <{'type': <'color'>, 'id': <'effect_default_light_color'>, 'params': <{'color': <(1.0, 1.0, 1.0, 0.5)>, 'blend_mode': <3>}>}>]>}, 'pipeline_liquid_glass': {'name': <'Liquid Glass'>, 'effects': <[<{'type': <'luminosity'>, 'id': <'effect_liquid_glass_luminosity'>, 'params': <{'saturation_multiplicator': <1.1000000000000001>}>}>, <{'type': <'refraction'>, 'id': <'effect_liquid_glass_refraction'>, 'params': <{'tint': <0>}>}>, <{'type': <'noise'>, 'id': <'effect_liquid_glass_noise'>, 'params': <{'noise': <0.10000000000000001>}>}>]>}, 'pipeline_vapor_glass': {'name': <'Vapor Glass'>, 'effects': <[<{'type': <'luminosity'>, 'id': <'effect_vapor_glass_luminosity'>, 'params': <{'saturation_multiplicator': <1.1000000000000001>}>}>, <{'type': <'wave'>, 'id': <'effect_vapor_glass_wave'>, 'params': <@a{sv} {}>}>, <{'type': <'refraction'>, 'id': <'effect_vapor_glass_refraction'>, 'params': <{'tint': <0>}>}>, <{'type': <'noise'>, 'id': <'effect_vapor_glass_noise'>, 'params': <{'noise': <0.10000000000000001>}>}>]>}, 'pipeline_classic_light_background': {'name': <'Classic Light Background'>, 'effects': <[<{'type': <'dual_kawase_blur'>, 'id': <'effect_classic_light_blur'>, 'params': <{'unscaled_radius': <30>, 'brightness': <0.59999999999999998>}>}>, <{'type': <'color'>, 'id': <'effect_classic_light_color'>, 'params': <{'color': <(1.0, 1.0, 1.0, 0.25)>, 'blend_mode': <17>}>}>]>}, 'pipeline_classic_dark_background': {'name': <'Classic Dark Background'>, 'effects': <[<{'type': <'dual_kawase_blur'>, 'id': <'effect_classic_dark_blur'>, 'params': <{'unscaled_radius': <30>, 'brightness': <0.59999999999999998>}>}>, <{'type': <'color'>, 'id': <'effect_classic_dark_color'>, 'params': <{'color': <(0.40000000000000002, 0.40000000000000002, 0.40000000000000002, 0.34999999999999998)>, 'blend_mode': <17>}>}>]>}}
power-saver=false
rounded-blur-notice-dismissed=true
settings-version=10

[org/gnome/shell/extensions/blur-my-shell/applications]
blur=false
pipeline='pipeline_default'
pipeline-dark='pipeline_default'
pipeline-light='pipeline_default_light'

[org/gnome/shell/extensions/blur-my-shell/dash-to-dock]
pipeline='pipeline_default'
pipeline-auto-mode=false
pipeline-dark='pipeline_default'
pipeline-light='pipeline_default_light'
static-blur=false

[org/gnome/shell/extensions/blur-my-shell/lockscreen]
pipeline='pipeline_default'
pipeline-auto-mode=true
pipeline-dark='pipeline_default'
pipeline-light='pipeline_default_light'

[org/gnome/shell/extensions/blur-my-shell/panel]
blur=true
pipeline='pipeline_default'
pipeline-auto-mode=false
pipeline-dark='pipeline_default'
pipeline-light='pipeline_default_light'
static-blur=false
style-panel=0
unblur-in-overview=true

[org/gnome/shell/extensions/blur-my-shell/popup]
screenshot-corner-radius=36

[org/gnome/shell/extensions/blur-my-shell/screenshot]
pipeline='pipeline_default'
pipeline-auto-mode=true
pipeline-dark='pipeline_default'
pipeline-light='pipeline_default_light'

[org/gnome/shell/extensions/clipboard-indicator]
enable-keybindings=true
toggle-menu=['<Super>v']

[org/gnome/shell/extensions/dash-to-dock]
always-center-icons=true
app-hotkey-1=@as []
app-hotkey-10=@as []
