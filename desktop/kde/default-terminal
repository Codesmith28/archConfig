#!/usr/bin/env bash
# ==============================================================================
# Default Terminal Launcher (KDE Plasma & Universal)
# ==============================================================================
# Resolves and launches the user's preferred terminal emulator, checking KDE /
# GNOME default configurations and falling back gracefully to available
# terminal emulators on the system (Ghostty, Ptyxis, Konsole, etc.).
# ==============================================================================
set -euo pipefail

SCRIPT_NAME="$(basename "$0")"

resolve_bin() {
    local target="$1"
    [[ -z "$target" ]] && return 1
    if [[ "$target" == *"$SCRIPT_NAME"* || "$target" == "default-terminal" || "$target" == "default-terminal.desktop" ]]; then
        return 1
    fi
    if [[ "$target" == *.desktop ]]; then
        target="${target%.desktop}"
        target="${target##*.}"
    fi
    if command -v "$target" >/dev/null 2>&1; then
        echo "$target"
        return 0
    fi
    return 1
}

# 1. Check KDE Terminal preference if kreadconfig is available
KDE_TERM=""
if command -v kreadconfig6 >/dev/null 2>&1; then
    KDE_TERM="$(kreadconfig6 --file kdeglobals --group General --key TerminalApplication 2>/dev/null || true)"
elif command -v kreadconfig5 >/dev/null 2>&1; then
    KDE_TERM="$(kreadconfig5 --file kdeglobals --group General --key TerminalApplication 2>/dev/null || true)"
fi

if [[ -n "$KDE_TERM" ]]; then
    if RESOLVED="$(resolve_bin "$KDE_TERM")"; then
        exec "$RESOLVED" "$@"
    fi
fi

# 2. Check GNOME desktop preference
if command -v gsettings >/dev/null 2>&1; then
    TERM_EXEC="$(gsettings get org.gnome.desktop.default-applications.terminal exec 2>/dev/null | tr -d "'\"" || true)"
    if [[ -n "$TERM_EXEC" ]]; then
        if RESOLVED="$(resolve_bin "$TERM_EXEC")"; then
            exec "$RESOLVED" "$@"
        fi
    fi
fi

# 3. Fallbacks in priority order
for t in ghostty ptyxis konsole gnome-terminal alacritty foot wezterm xterm kitty; do
    if command -v "$t" >/dev/null 2>&1; then
        exec "$t" "$@"
    fi
done

echo "Error: No supported terminal emulator found." >&2
exit 1
