#!/usr/bin/env python3
"""Universal KDE Plasma Do Not Disturb Toggle & Reader."""
import os, sys, configparser

def get_dnd_status():
    plasmanotifyrc = os.path.expanduser("~/.config/plasmanotifyrc")
    if os.path.exists(plasmanotifyrc):
        cfg = configparser.RawConfigParser(strict=False)
        cfg.read(plasmanotifyrc)
        if cfg.has_section("DoNotDisturb"):
            return True
    return False

def toggle_dnd():
    # Invoke native plasmashell shortcut action
    try:
        import dbus
        bus = dbus.SessionBus()
        kglobal = bus.get_object("org.kde.kglobalaccel", "/component/plasmashell")
        iface = dbus.Interface(kglobal, "org.kde.kglobalaccel.Component")
        iface.invokeShortcut("toggle do not disturb")
        import time
        time.sleep(0.1)
        return get_dnd_status()
    except Exception:
        pass
    return get_dnd_status()

def main():
    arg = sys.argv[1].lower() if len(sys.argv) > 1 else ""

    if arg in ("read", "get", "status", "curr", "current"):
        status = get_dnd_status()
        print(f"Do Not Disturb: {'ON' if status else 'OFF'}")
    else:
        status_before = get_dnd_status()
        new_status = toggle_dnd()
        print(f"Do Not Disturb toggled: {'ON' if new_status else 'OFF'}")

if __name__ == "__main__":
    main()
