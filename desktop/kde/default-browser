#!/usr/bin/env bash
# ==============================================================================
# Default Web Browser Launcher (KDE Plasma & Universal)
# ==============================================================================
# Resolves and launches the user's preferred web browser, checking KDE /
# XDG default configurations and falling back gracefully to available
# browsers on the system (Zen, Firefox, Chrome, Chromium, etc.).
# ==============================================================================
set -euo pipefail

SCRIPT_NAME="$(basename "$0")"

resolve_bin() {
    local target="$1"
    [[ -z "$target" ]] && return 1
    # Prevent recursive self-invocation
    if [[ "$target" == *"$SCRIPT_NAME"* || "$target" == "default-browser" || "$target" == "default-browser.desktop" ]]; then
        return 1
    fi

    # Strip .desktop extension
    if [[ "$target" == *.desktop ]]; then
        target="${target%.desktop}"
        target="${target##*.}" # e.g. org.mozilla.firefox -> firefox
    fi

    if command -v "$target" >/dev/null 2>&1; then
        echo "$target"
        return 0
    fi
    return 1
}

# 1. Check KDE Browser preference if kreadconfig is available
KDE_BROWSER=""
if command -v kreadconfig6 >/dev/null 2>&1; then
    KDE_BROWSER="$(kreadconfig6 --file kdeglobals --group General --key BrowserApplication 2>/dev/null || true)"
elif command -v kreadconfig5 >/dev/null 2>&1; then
    KDE_BROWSER="$(kreadconfig5 --file kdeglobals --group General --key BrowserApplication 2>/dev/null || true)"
fi

if [[ -n "$KDE_BROWSER" ]]; then
    if RESOLVED="$(resolve_bin "$KDE_BROWSER")"; then
        exec "$RESOLVED" "$@"
    fi
fi

# 2. Check XDG default web browser
if command -v xdg-settings >/dev/null 2>&1; then
    XDG_BROWSER="$(xdg-settings get default-web-browser 2>/dev/null || true)"
    if [[ -n "$XDG_BROWSER" ]]; then
        if RESOLVED="$(resolve_bin "$XDG_BROWSER")"; then
            exec "$RESOLVED" "$@"
        fi
    fi
fi

# 3. Known browser candidates in priority order
for b in zen-browser zen firefox google-chrome-stable google-chrome chromium brave-browser epiphany; do
    if command -v "$b" >/dev/null 2>&1; then
        exec "$b" "$@"
    fi
done

# 4. Fallback to gio / xdg-open if URL passed
if [[ $# -gt 0 ]]; then
    if command -v xdg-open >/dev/null 2>&1; then
        exec xdg-open "$@"
    fi
fi

echo "Error: No supported web browser found." >&2
exit 1
