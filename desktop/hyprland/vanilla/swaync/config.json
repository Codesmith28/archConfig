{
  "$schema": "/etc/swaync/config-schema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "overlay",
  "layer-shell": true,
  "cssPriority": "application",
  "notification-icon-size": 48,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "timeout": 8,
  "timeout-low": 4,
  "timeout-critical": 0,
  "margin-top": 10,
  "margin-bottom": 10,
  "margin-right": 10,
  "margin-left": 0,
  "notification-window-width": 380,
  "control-center-width": 420,
  "control-center-height": 650,
  "control-center-margin-top": 10,
  "control-center-margin-right": 10,
  "control-center-margin-bottom": 10,
  "control-center-margin-left": 0,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": true,
  "hide-on-action": true,
  "fit-to-screen": false,
  "widgets": [
    "title",
    "dnd",
    "volume",
    "backlight",
    "mpris",
    "notifications",
    "buttons-grid"
  ],
  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear All"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "label": {
      "max-lines": 5,
      "text": "Notifications"
    },
    "volume": {
      "label": "󰕾 VOL",
      "show-per-app": false
    },
    "backlight": {
      "label": "󰃞 BRI"
    },
    "mpris": {
      "image-size": 56,
      "image-radius": 10
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "󰌾  Lock",
          "command": "sh -c 'command -v hyprlock >/dev/null 2>&1 && hyprlock || loginctl lock-session'"
        },
        {
          "label": "󰤄  Sleep",
          "command": "systemctl suspend"
        },
        {
          "label": "󰍃  Logout",
          "command": "sh -c 'if [ -x \"$HOME/.config/hypr/scripts/logout.sh\" ]; then \"$HOME/.config/hypr/scripts/logout.sh\"; elif [ -x \"$HOME/archConfig/desktop/hyprland/vanilla/hypr/scripts/logout.sh\" ]; then \"$HOME/archConfig/desktop/hyprland/vanilla/hypr/scripts/logout.sh\"; else hyprctl dispatch exit; fi'"
        },
        {
          "label": "󰜉  Reboot",
          "command": "systemctl reboot"
        },
        {
          "label": "󰐥  Shutdown",
          "command": "systemctl poweroff"
        }
      ]
    }
  }
}
